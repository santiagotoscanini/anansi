<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The Apple Watch app: only keys Xcode can't generate from INFOPLIST_KEY_* build settings. -->
<plist version="1.0">
<dict>
	<key>WKApplication</key>
	<true/>
	<!-- A note keeps recording with the wrist down and the screen off. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
	<!-- anansiwatch://record: the complication opens the app recording. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.santiagotoscanini.anansi.watchkitapp.record</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>anansiwatch</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
