// Single source of truth for app identity and versioning.
// CI overrides CURRENT_PROJECT_VERSION with the workflow run number.

DEVELOPMENT_TEAM = H8M3SN9RDZ
PRODUCT_BUNDLE_IDENTIFIER = com.santiagotoscanini.anansi
INFOPLIST_KEY_CFBundleDisplayName = Anansi
INFOPLIST_KEY_LSApplicationCategoryType = public.app-category.lifestyle

MARKETING_VERSION = 0.1.0
CURRENT_PROJECT_VERSION = 1

IPHONEOS_DEPLOYMENT_TARGET = 27.0
TARGETED_DEVICE_FAMILY = 1,2

// Privacy
INFOPLIST_KEY_NSCameraUsageDescription = Anansi uses the camera for the pictures in your weekly sync and to scan the QR code that connects it.
INFOPLIST_KEY_NSPhotoLibraryUsageDescription = Anansi attaches pictures from your library to your weekly sync.
// anansi://connect links (the web's Devices QR code) open the app.
INFOPLIST_FILE = Config/Info.plist

// Apple Health (read only). The entitlements are embedded by an ad-hoc signature at archive time and kept by the
// export's distribution signature: see ios-deploy.yml.
CODE_SIGN_ENTITLEMENTS = Config/Anansi.entitlements
INFOPLIST_KEY_NSHealthShareUsageDescription = Anansi reads your daily sleep, activity, body and heart totals from Health and keeps them with your weekly syncs.
// App Store validation asks for the write string whenever the HealthKit entitlement is present, even though
// Anansi never writes to Health.
INFOPLIST_KEY_NSHealthUpdateUsageDescription = Anansi does not write to Health. It only reads your daily totals to show them with your weekly syncs.
