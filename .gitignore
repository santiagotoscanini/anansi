# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
/out/

# vite / tanstack start / nitro
/.output/
/.nitro/
/.tanstack/
/dist/
# Generated by the TanStack Router plugin (and `tsr generate`) from the files
# in src/routes — derived, not source. `pnpm typecheck` regenerates it first
# so a fresh clone type-checks without an install-time side effect.
/src/routeTree.gen.ts

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local env files
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Local S3
public/.s3-local/.bucket

# Mac files
.DS_Store

# Local image files (top-level user uploads only — must NOT match
# src/app/uploads/[...path]/, which is the route handler that serves them).
/uploads/

.playwright-mcp

# Local logs and personal notes
.dev.log
GET-SHIT-DONE.md

# Phase 0 migration oracle is committed; keep credential material out of it
.golden/*cookie*
.golden/*token*
