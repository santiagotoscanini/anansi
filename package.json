{
  "name": "goals-app",
  "version": "0.3.0",
  "private": true,
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=24",
    "pnpm": ">=11"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && vite build --config vite.scripts.config.ts",
    "check:bundle": "test -d .output/public && ! grep -rqE 'drizzle-orm|@auth/core|bcryptjs|postgres:' .output/public/ && ! grep -rqE 'placeholder-secret|postgresql://(ci|build)' .output/public/",
    "start": "node start.mjs",
    "generate-routes": "tsr generate",
    "lint": "eslint .",
    "typecheck": "tsr generate && tsc --noEmit",
    "format": "prettier --write .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:pull": "drizzle-kit pull",
    "db:check": "drizzle-kit check",
    "db:up": "drizzle-kit up",
    "db:studio": "drizzle-kit studio",
    "format:check": "prettier --check .",
    "check:mcp-tools": "tsx scripts/check-mcp-tools.ts",
    "test": "tsx --test 'src/**/!(object-store).test.ts' 'scripts/*.test.ts' && vitest run",
    "ci": "pnpm generate-routes && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm check:mcp-tools && pnpm check:bundle",
    "preview": "vite preview"
  },
  "type": "module",
  "dependencies": {
    "@auth/core": "0.41.3",
    "@auth/drizzle-adapter": "^1.11.2",
    "@aws-sdk/client-s3": "^3.1161.0",
    "@aws-sdk/lib-storage": "^3.1161.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/geist": "^5.3.0",
    "@fontsource/geist-mono": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@fontsource/newsreader": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@paralleldrive/cuid2": "^2.2.2",
    "@smithy/node-http-handler": "^4.14.0",
    "@t3-oss/env-core": "^0.13.11",
    "@tanstack/react-query": "^5.99.2",
    "@tanstack/react-router": "^1.170.18",
    "@tanstack/react-router-ssr-query": "^1.167.1",
    "@tanstack/react-start": "^1.168.32",
    "@xyflow/react": "^12.8.2",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.2.2",
    "drizzle-orm": "^0.44.5",
    "emoji-picker-react": "^4.14.0",
    "i18next": "^26.1.0",
    "i18next-browser-languagedetector": "^8.2.1",
    "lucide-react": "^0.469.0",
    "postgres": "^3.4.7",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-hot-toast": "^2.5.2",
    "react-i18next": "^17.0.7",
    "uqr": "^0.1.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@eslint/js": "^10.0.1",
    "@rolldown/plugin-babel": "^0.2.3",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/devtools-vite": "^0.8.3",
    "@tanstack/react-devtools": "^0.10.9",
    "@tanstack/react-router-devtools": "^1.167.0",
    "@tanstack/router-cli": "^1.167.21",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "babel-plugin-react-compiler": "^1.0.0",
    "drizzle-kit": "^0.31.4",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-i18next": "^6.1.4",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "^16.4.0",
    "nitro": "3.0.260610-beta",
    "playwright": "^1.61.1",
    "prettier": "^3.2.5",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.12"
  }
}
