# Keep the build context tiny and the final image free of dev/local junk.
# Anything excluded here is invisible to every Docker COPY in the Dockerfile,
# so it also can't accidentally leak into a layer.

# Build outputs — rebuilt inside the image.
.output
.nitro
.tanstack
out
dist
node_modules

# VCS + CI metadata.
.git
.gitignore
.github

# Local env files — these MUST stay out of the image.
.env
.env.*
!.env.example

# Editor/IDE configs.
.vscode
.idea
*.swp

# OS noise.
.DS_Store
Thumbs.db

# Logs + local caches.
*.log
.npm
.eslintcache
.cache

# Tests + screenshots from local verification runs.
#
# `/*.png` is anchored to the context root ON PURPOSE. A bare `*.png` matches
# at every depth, which would exclude public/icon.png and public/apple-icon.png
# and ship an image with no favicon — silently, since a missing icon is a 404
# the browser never complains about.
.playwright-mcp
/*.png
coverage
# NOT excluded any more: Railpack honours .dockerignore, and the `ci` script’s
# check:mcp-tools reads .golden/mcp-tool-names.tsv as its oracle.

# Docs that don't ship with the runtime.
README.md
CLAUDE.md
docs

# Docker itself.
Dockerfile
.dockerignore
docker-compose*.yml
