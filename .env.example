# Postgres connection string. For local dev, use a Supabase Session Pooler URL
# (free tier, IPv4-compatible) — Project → Connect → Session pooler.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Supabase Auth. Get both from Project Settings → API in the Supabase dashboard.
# - URL is the project's REST endpoint root (the same project_ref that's in
#   DATABASE_URL above).
# - The publishable key (sb_publishable_…) is the new client-side key that
#   replaced anon. Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Server-only. Bypasses RLS — never expose to the client. Used by tRPC
# procedures that upload to / sign URLs for Supabase Storage. Required
# because Storage does not currently propagate the user's session JWT
# into Postgres RLS evaluation under the new asymmetric-JWT scheme; the
# server holds an elevated key and constructs paths from the verified
# `ctx.user.userId` (same security model as Drizzle going through the
# postgres role). Project Settings → API → service_role secret.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_replace_me

# Optional — only consumed by the production docker-compose.yml. Safe to ignore
# for local dev.
# APP_PORT=14711
# NODE_ENV=production
# DB_USER=user
# DB_PASSWORD=password
# DB_NAME=goals_db
