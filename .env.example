# Database Configuration
DB_USER=user
DB_PASSWORD=password
DB_NAME=goals_db
DB_PORT=15822

# Application Configuration
APP_PORT=14711
NODE_ENV=production

# Required — used by jose (JWE A256GCM) to sign auth cookies. Must be at least
# 32 characters; the app refuses to start otherwise. Generate with:
#   openssl rand -base64 48
JWT_SECRET=replace-me-with-32-plus-bytes-of-random

# Database URL (constructed from above vars in docker-compose)
# For local development outside Docker:
# DATABASE_URL=postgresql://user:password@localhost:15822/goals_db