# Postgres connection string. Anansi uses any Postgres — local docker-compose,
# Railway, Supabase Session Pooler URL, RDS, whatever. The Drizzle migrations
# in `src/lib/data/db/migrations/` create the entire schema, including the
# Auth.js `accounts` table.
DATABASE_URL=postgresql://user:password@localhost:5432/anansi

# Auth.js — the secret used to sign the JWT session cookie. Generate with:
#   openssl rand -base64 32
# In production set `AUTH_TRUST_HOST=true` if you're behind a reverse proxy
# whose host header you trust (Vercel, Fly, Railway, your own nginx).
AUTH_SECRET=replace_me_with_a_strong_random_string

# ── Single sign-on (OIDC) ────────────────────────────────────────────────────
# All optional, and all left unset for local dev. Their ABSENCE is what selects
# email + password sign-in; set the first four and the app becomes SSO-only,
# with /register gated off. Never keyed on NODE_ENV.
#
# OIDC_REDIRECT_URI has to match what is registered at the identity provider
# byte for byte, and its last path segment IS the Auth.js provider id — the
# callback path is always `${AUTH_URL}/api/auth/callback/<provider id>`.
#
# OIDC_ISSUER_URL=https://id.example.com
# OIDC_CLIENT_ID=anansi
# OIDC_CLIENT_SECRET=replace_me
# OIDC_REDIRECT_URI=https://anansi.example.com/api/auth/callback/pocket-id
# OIDC_PROVIDER_ID=pocket-id
# OIDC_PROVIDER_NAME=Pocket ID
# OIDC_SCOPES=openid profile email groups

# Optional. Set MIGRATE_ONLY=1 to make the container entrypoint apply migrations
# and exit without starting the server — used as a systemd ExecStartPre hook.
# MIGRATE_ONLY=1
