# Postgres connection string. Anansi uses any Postgres — local docker-compose,
# Railway, Supabase Session Pooler URL, RDS, whatever. The Drizzle migrations
# in `src/lib/data/db/migrations/` create the entire schema, including the
# Auth.js `accounts` table.
DATABASE_URL=postgresql://user:password@localhost:5432/anansi

# Auth.js — the secret used to sign the JWT session cookie. Generate with:
#   openssl rand -base64 32
# In production set `AUTH_TRUST_HOST=true` if you're behind a reverse proxy
# whose host header you trust (Vercel, Fly, Railway, your own nginx).
AUTH_SECRET=replace_me_with_a_strong_random_string

# ── Single sign-on (OIDC) ────────────────────────────────────────────────────
# All optional, and all left unset for local dev. Their ABSENCE is what selects
# email + password sign-in; setting the first four adds the IdP button. It does
# NOT close /register — the two doors stay open side by side, and OIDC_EMAILS
# below is what keeps them apart. Never keyed on NODE_ENV.
#
# OIDC_REDIRECT_URI has to match what is registered at the identity provider
# byte for byte, and its last path segment IS the Auth.js provider id — the
# callback path is always `${AUTH_URL}/api/auth/callback/<provider id>`.
#
# OIDC_ISSUER_URL=https://id.example.com
# OIDC_CLIENT_ID=anansi
# OIDC_CLIENT_SECRET=replace_me
# OIDC_REDIRECT_URI=https://anansi.example.com/api/auth/callback/pocket-id
# OIDC_PROVIDER_ID=pocket-id
# OIDC_PROVIDER_NAME=Pocket ID
# OIDC_SCOPES=openid profile email groups

# Comma-separated addresses that may sign in ONLY through the IdP. Registration
# rejects them and the password provider refuses them even if a hash exists, so
# nobody can squat the operator's address with a password account before the
# first OIDC sign-in lands. Unset for local dev.
# OIDC_EMAILS=owner@example.com,second-admin@example.com

# ── Invite gate ──────────────────────────────────────────────────────────────
# Set = /register asks for a code, and this value is the break-glass master one
# (each member's own `users.invite_code` works too, but that needs a user to
# exist first). Unset = open registration, which is a deliberate state, not an
# oversight. Left unset here so a fresh clone can register straight away.
# INVITE_CODE=not-a-real-code-pick-your-own

# ── Object storage (the bucket every uploaded file's bytes live in) ─────────
# Injected by the box's apps platform when Object storage is on for the app:
# all five or none. Unset in local dev, where uploads are kept in memory and
# gone on restart. A production container refuses to boot without them.
#
# S3_ENDPOINT=http://garage:3900
# S3_REGION=garage
# S3_BUCKET=anansi
# S3_ACCESS_KEY_ID=GK…
# S3_SECRET_ACCESS_KEY=replace_me

# Optional. Set MIGRATE_ONLY=1 to make the container entrypoint apply migrations
# and exit without starting the server — used as a systemd ExecStartPre hook.
# MIGRATE_ONLY=1
